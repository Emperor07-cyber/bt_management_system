# ============================================================
# BT MANAGEMENT SYSTEM - PRODUCTION ENVIRONMENT
# ============================================================

# Django
DEBUG=False

# Replace this with a long random value during installation.
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY

# Local-only deployment
ALLOWED_HOSTS=127.0.0.1,localhost

# Frontend is served locally on port 8080.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# CSRF trusted origins for local HTTP deployment.
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# ============================================================
# DATABASE
# ============================================================

DB_NAME=bt_management_system
DB_USER=bt_app
DB_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=5432

# ============================================================
# APPLICATION PORTS
# ============================================================

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=8080